DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_SECONDS=120

# Static Seattle boundary ingestion. Keep this equal to GRID_SIZE_DEGREES so
# spatially derived grid IDs match IDs assigned by the live vehicle pipeline.
GEOGRAPHY_GRID_SIZE_DEGREES=0.01

DETAIL_RETENTION_HOURS=24
AGGREGATE_RETENTION_DAYS=35
PIPELINE_RUN_RETENTION_DAYS=90
REJECTED_RETENTION_DAYS=14
FEED_STALE_MINUTES=10
VOLUME_DROP_THRESHOLD=0.50
VOLUME_DROP_POLICY=WARNING

SEATTLE_BBOX_MIN_LAT=
SEATTLE_BBOX_MAX_LAT=
SEATTLE_BBOX_MIN_LON=
SEATTLE_BBOX_MAX_LON=

GRID_SIZE_DEGREES=0.01
REBALANCE_HIGH_THRESHOLD=10
REBALANCE_MEDIUM_THRESHOLD=5
